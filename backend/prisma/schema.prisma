generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

//-----------------------------------------------------------------------------------------------------------------------------
// ============================================
// =============   Address   ==================
// ============================================

// ------------------ COUNTRY ------------------
model Country {
  id   Int    @id @default(autoincrement())
  name String @unique

  states State[]
}

// ------------------ STATE ------------------
model State {
  id        Int    @id @default(autoincrement())
  name      String @unique
  countryId Int

  country Country @relation(fields: [countryId], references: [id])
  cities  City[]

  @@unique([name, countryId])
}

// ------------------ CITY ------------------
model City {
  id      Int    @id @default(autoincrement())
  name    String @unique
  stateId Int

  state   State     @relation(fields: [stateId], references: [id])
  address Address[]
  service Service[]

  @@unique([name, stateId])
}

// ------------------ ADDRESS ------------------
model Address {
  id         Int    @id @default(autoincrement())
  location   String
  postalcode Int
  latitude   Float
  longitude  Float
  cityId     Int

  city City @relation(fields: [cityId], references: [id])

  venues   Venue[]
  provider ProviderProfile[]
}

// =================== ENUMS =====================
enum VenueStatus {
  DRAFT
  ACTIVE
  UNDER_MAINTENANCE
  PENDING
  BLOCKED
  DELETED
}

enum ServiceStatus {
  DRAFT
  ACTIVE
  TEMPORARILY_UNAVAILABLE
  PENDING
  BLOCKED
  DELETED
}

enum PriceUnit {
  HOURLY
  DAILY
}

enum ProviderStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  DELETED
}

// ----------------------- BOOKING STATUS ENUM -----------------------
enum BookingStatus {
  CART
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  COMPLETED
  REFUNDED
}

// ----------------------- PAYMENT ENUMS -----------------------
enum PaymentMethod {
  UPI
  CREDIT_CARD
  CASH
  BANK_CHEQUE
}

enum PaymentStatus {
  SUCCESS
  PENDING
  FAILED
  CANCELLED
}

//-----------------------------------------------------------------------------------------------------------------------------

// ============================================
// =============   Venue   ==================
// ============================================

// ----------------------- VENUE -----------------------
model Venue {
  id             Int     @id @default(autoincrement())
  venuename      String
  description    String
  capacity       Int
  contactemail   String
  contactnumber1 String
  contactnumber2 String?

  rating Decimal @default(0.0) @db.Decimal(3, 2)

  status VenueStatus @default(DRAFT)

  providerId Int
  provider   ProviderProfile @relation(fields: [providerId], references: [id])

  addressId Int
  address   Address @relation(fields: [addressId], references: [id])

  features VenueFeature[]
  types    VenueType[]
  photos   VenuePhoto[]
  reviews  VenueReview[]
  stats    VenueStatistic[]
  pricing  VenuePricingRule[]
  bookings Booking[]
  wishes   Wishlist[]
}

// ----------------------- FEATURE -----------------------
model Feature {
  id   Int    @id @default(autoincrement())
  name String @unique
  icon String

  venues VenueFeature[]
}

// Many-to-Many bridge
model VenueFeature {
  id        Int @id @default(autoincrement())
  venueId   Int
  featureId Int

  venue   Venue   @relation(fields: [venueId], references: [id])
  feature Feature @relation(fields: [featureId], references: [id])

  @@unique([venueId, featureId])
}

// ----------------------- VENUE TYPE -----------------------
model TypeOfVenue {
  id   Int    @id @default(autoincrement())
  name String
  icon String

  venues VenueType[]
}

// Many-to-Many bridge
model VenueType {
  id      Int @id @default(autoincrement())
  venueId Int
  typeId  Int

  venue Venue       @relation(fields: [venueId], references: [id])
  type  TypeOfVenue @relation(fields: [typeId], references: [id])

  @@unique([venueId, typeId])
}

// ----------------------- PHOTOS -----------------------
model VenuePhoto {
  id          Int     @id @default(autoincrement())
  image       String
  description String?
  order       Int

  venueId Int
  venue   Venue @relation(fields: [venueId], references: [id])

  @@unique([venueId, order])
}

// ----------------------- REVIEWS -----------------------
model VenueReview {
  id      Int     @id @default(autoincrement())
  rating  Int
  comment String?

  venueId Int
  userId  Int

  venue Venue @relation(fields: [venueId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ----------------------- STATISTICS -----------------------
model VenueStatistic {
  id                Int      @id @default(autoincrement())
  statDate          DateTime @default(now())
  pageViews         Int?
  bookingrequests   Int?
  confirmedbookings Int?
  revenue           Decimal? @db.Decimal(10, 2)

  venueId Int
  venue   Venue @relation(fields: [venueId], references: [id])
}

// ----------------------- PRICING RULES -----------------------
model VenuePricingRule {
  id        Int       @id @default(autoincrement())
  venueId   Int
  unit      PriceUnit
  price     Decimal   @db.Decimal(10, 2)
  startTime DateTime?
  endTime   DateTime?

  venue Venue @relation(fields: [venueId], references: [id])
}

//-----------------------------------------------------------------------------------------------------------------------------

// ============================================
// =============   Service   ==================
// ============================================

// ================= SERVICE CATEGORY =================
model ServiceCategory {
  id   Int    @id @default(autoincrement())
  name String @unique

  services Service[]
}

// ================= SERVICE =================
model Service {
  id          Int     @id @default(autoincrement())
  name        String
  description String
  basePrice   Decimal @db.Decimal(10, 2)

  categoryId Int
  providerId Int
  cityId     Int

  rating Decimal @default(0.0) @db.Decimal(3, 2)

  status ServiceStatus @default(PENDING)

  category ServiceCategory @relation(fields: [categoryId], references: [id])
  provider ProviderProfile @relation(fields: [providerId], references: [id])
  city     City            @relation(fields: [cityId], references: [id])

  bookings          BookingService[]
  serviceReviews    ServiceReview[]
  serviceStatistics ServiceStatistic[]
}

model ServiceReview {
  id      Int     @id @default(autoincrement())
  rating  Int
  comment String?

  serviceId Int
  userId    Int

  service Service @relation(fields: [serviceId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, serviceId])
}

model ServiceStatistic {
  id        Int      @id @default(autoincrement())
  statDate  DateTime @default(now())
  views     Int?
  inquiries Int?
  bookings  Int?
  revenue   Decimal? @db.Decimal(10, 2)

  serviceId Int
  service   Service @relation(fields: [serviceId], references: [id])
}

//-----------------------------------------------------------------------------------------------------------------------------

// ============================================
// =============   Bookings   ==================
// ============================================

// ----------------------- BOOKING -----------------------
model Booking {
  id Int @id @default(autoincrement())

  userId  Int
  venueId Int

  bookingStatus BookingStatus @default(CART)

  startTime              DateTime
  endTime                DateTime
  numberOfGuestsExpected Int?
  pricePerUnit Decimal   // price at the booking time
  totalCost              Decimal  @db.Decimal(10, 2)

  venue Venue @relation(fields: [venueId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  services BookingService[]
  payment  Payment?

  expiresAt DateTime? // for PENDING_PAYMENT state

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([venueId])
  @@index([venueId, startTime])
  @@index([venueId, startTime, endTime])
  @@index([userId])
}

// ----------------------- BOOKING SERVICES (Many-to-Many) -----------------------
model BookingService {
  id Int @id @default(autoincrement())

  bookingId Int
  serviceId Int

  priceAtBooking Decimal @db.Decimal(10, 2)

  booking Booking @relation(fields: [bookingId], references: [id])
  service Service @relation(fields: [serviceId], references: [id])

  @@unique([bookingId, serviceId])
}

// ----------------------- PAYMENT -----------------------
model Payment {
  id            Int     @id @default(autoincrement())
  bookingId     Int     @unique
  transactionId String  @unique
  amount        Decimal @db.Decimal(10, 2)

  paymentMethod PaymentMethod @default(CREDIT_CARD)
  status        PaymentStatus @default(PENDING)

  booking Booking @relation(fields: [bookingId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//-----------------------------------------------------------------------------------------------------------------------------

// ============================================
// =============   RBAC & other ...   ==================
// ============================================

// ----------------------- USER -----------------------
model User {
  id            Int     @id @default(autoincrement())
  contactnumber String  @unique
  fullname      String
  email         String? @unique
  isverified    Boolean @default(false)
  isDeleted     Boolean @default(false)

  roles           UserRole[]
  wishlists       Wishlist[]
  logs            ActionLog[]
  provider        ProviderProfile?
  venuereviews    VenueReview[]
  servicesreviews ServiceReview[]
  bookings        Booking[]
}

// ----------------------- ROLE -----------------------
model Role {
  id       Int              @id @default(autoincrement())
  rolename String           @unique
  users    UserRole[]
  perms    RolePermission[]
}

// ----------------------- USER ROLE  -----------------------
model UserRole {
  id        Int     @id @default(autoincrement())
  userId    Int
  roleId    Int
  isDeleted Boolean @default(false)

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
}

// ----------------------- APP TABLE -----------------------
model AppTable {
  id          Int    @id @default(autoincrement())
  tablename   String @unique
  displayname String @unique

  menuLinks MenuLink[]
  perms     RolePermission[]
  logs      ActionLog[]
}

// ----------------------- OPERATION -----------------------
model Operation {
  id            Int    @id @default(autoincrement())
  operationname String @unique

  perms RolePermission[]
  logs  ActionLog[]
}

// ----------------------- ROLE PERMISSION -----------------------
model RolePermission {
  id          Int     @id @default(autoincrement())
  roleId      Int
  tableId     Int
  operationId Int
  isDeleted   Boolean @default(false)

  role      Role      @relation(fields: [roleId], references: [id])
  table     AppTable  @relation(fields: [tableId], references: [id])
  operation Operation @relation(fields: [operationId], references: [id])

  @@unique([roleId, tableId, operationId])
}

// ----------------------- ACTION LOG -----------------------
model ActionLog {
  id                Int      @id @default(autoincrement())
  userId            Int
  tableId           Int
  operationId       Int
  operationObjectID Int?
  operationDate     DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id])
  table     AppTable  @relation(fields: [tableId], references: [id])
  operation Operation @relation(fields: [operationId], references: [id])
}

// ----------------------- MENU LINK (Self Relation) -----------------------
model MenuLink {
  id          Int     @id @default(autoincrement())
  displayname String  @unique
  url         String
  icon        String?
  tableId     Int

  parentId Int?
  parent   MenuLink?  @relation("MenuParent", fields: [parentId], references: [id])
  children MenuLink[] @relation("MenuParent")

  table AppTable @relation(fields: [tableId], references: [id])
}

// ----------------------- WISHLIST -----------------------
model Wishlist {
  id      Int @id @default(autoincrement())
  userId  Int
  venueId Int

  user  User  @relation(fields: [userId], references: [id])
  venue Venue @relation(fields: [venueId], references: [id])

  @@unique([userId, venueId])
}

// ----------------------- PROVIDER -----------------------
model ProviderProfile {
  id          Int      @id @default(autoincrement())
  userId      Int      @unique
  legalname   String
  contact1    String
  contact2    String?
  dateOfBirth DateTime
  idProof     String
  photo       String
  addressId   Int

  status ProviderStatus @default(DRAFT)

  address Address @relation(fields: [addressId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  venues   Venue[]
  services Service[]
}
